# ui/ (Vue frontend) - dependencies, caches, and build output are never
# committed. The build lands in internal/webui/dist/app (see that
# package's doc comment); only internal/webui/dist/.gitkeep is tracked so
# go:embed compiles on a fresh clone. CI and the release workflow build
# the dashboard before every binary they publish.
ui/node_modules/
ui/.vite/
ui/tsconfig.tsbuildinfo
internal/webui/dist/app/
